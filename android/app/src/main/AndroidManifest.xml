<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only needed to also scan /sdcard/EasyTier/; the app-external files dir
         never requires a permission. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Owns the easytier-core child process so it survives the UI closing. -->
        <service
            android:name=".CoreService"
            android:exported="false" />

        <!-- Headless control surface for on-device automation. Deliberately exported with
             NO permission: adb shell (uid 2000) does not hold custom permissions, so adding
             one here would make shell-based automation impossible. The only thing it can do
             is start/stop this app's own core, and a config path is validated against
             ConfigStore's own list, never an arbitrary file. -->
        <receiver
            android:name=".ControlReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.kkrainbow.easytier.mini.action.START" />
                <action android:name="com.kkrainbow.easytier.mini.action.STOP" />
                <action android:name="com.kkrainbow.easytier.mini.action.STATUS" />
                <action android:name="com.kkrainbow.easytier.mini.action.LIST" />
                <action android:name="com.kkrainbow.easytier.mini.action.SHUTDOWN" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
